# Select groq, azure_foundry, or mock. The app falls back to mock without credentials.
AI_PROVIDER=mock
AI_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
# Use an absolute local path only when you want a custom database location.
SOULPRINT_DB_PATH=
