# Select groq, azure_foundry, mock, or use the generic OPENAI_* variables.
AI_PROVIDER=mock
AI_MODEL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# Embeddings can use a separate OpenAI-compatible endpoint and model.
# Groq is typically used for chat while Foundry or another provider supplies embeddings.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Use an absolute local path only when you want a custom database location.
SOULPRINT_DB_PATH=
